diff --git a/src/mem/MAA/CoherentProgress.inc b/src/mem/MAA/CoherentProgress.inc
new file mode 100644
index 00000000..6374e5d3
--- /dev/null
+++ b/src/mem/MAA/CoherentProgress.inc
@@ -0,0 +1,159 @@
+// Included inside namespace gem5 by coherent_xbar.cc.
+CoherentXBar::ProgressRespQueue::ProgressRespQueue(EventManager &em,
+    ResponsePort &port, CoherentXBar &owner)
+    : RespPacketQueue(em, port), xbar(owner) {}
+bool CoherentXBar::ProgressRespQueue::sendTiming(PacketPtr packet)
+{
+    const RequestPtr request = packet->req;
+    const auto token = xbar.progressState ? xbar.progressState->active(request) : 0;
+    panic_if(xbar.progressState && !token, "Unowned normal progress response");
+    if (token) xbar.progressCheck(xbar.progressState->beginDelivery(request, token));
+    const bool accepted = RespPacketQueue::sendTiming(packet);
+    // The peer may have deleted packet. Only the retained Request/token is used.
+    if (token) {
+        xbar.progressCheck(xbar.progressState->finishDelivery(request, token, accepted));
+        xbar.armProgressWake();
+    }
+    return accepted;
+}
+Cycles CoherentXBar::chargeProgressAdmission(uint64_t token)
+{
+    if(token){++progressAdmissionCycles;return Cycles(1);}
+    return Cycles(0);
+}
+void CoherentXBar::progressCheck(ProgressResult result) const
+{
+    panic_if(result != ProgressResult::Granted, "Progress ownership transition failed");
+}
+void CoherentXBar::registerProducer(RequestPort &port, RequestorID id)
+{
+    panic_if(!progressState || !port.isConnected(), "Missing configured progress broker");
+    unsigned matches = 0;
+    for (unsigned i=0;i<cpuSidePorts.size();++i) {
+        if (&cpuSidePorts[i]->getPeer() != &port) continue;
+        panic_if(progressProducerPorts[i], "Duplicate direct producer port");
+        progressProducerPorts[i]=true;progressProducerIDs[i]=id;++matches;
+    }
+    panic_if(matches!=1, "Producer must connect directly to this XBar, not via retirement cache");
+}
+void CoherentXBar::registerSpdConsumer(const AddrRange &range)
+{
+    panic_if(!progressState || progressSpdRegistered, "Duplicate/missing progress SPD owner");
+    progressSpdRange=range;progressSpdRegistered=true;
+}
+void CoherentXBar::registerCache(const std::vector<ResponsePort*> &ports,
+    unsigned banks,unsigned entries,unsigned targets,unsigned block,
+    std::function<maa::ProgressCachePlan(PacketPtr)> plan,
+    std::function<void(unsigned)> wake)
+{
+    panic_if(!progressState || progressCachePlan || banks!=4 || entries!=64 ||
+        targets!=8 || block!=64 || ports.size()!=4 || memSidePorts.size()!=4,
+        "Progress cache geometry differs from selected 4x64/8/64");
+    for(unsigned i=0;i<4;++i)
+        panic_if(!ports[i]->isConnected() || &ports[i]->getPeer()!=memSidePorts[i],
+                 "Progress cache/XBar bank peer mismatch");
+    progressCachePlan=std::move(plan);progressCacheWake=std::move(wake);
+}
+bool CoherentXBar::isSpdLine(Addr address) const
+{
+    panic_if(!progressSpdRegistered,"Progress SPD range unregistered");
+    return progressSpdRange.contains(address);
+}
+uint64_t CoherentXBar::authorizeSpdReceive(const RequestPtr&r,Addr line,unsigned port)const
+{
+    return progressState ? progressState->authorize(r,line,port) : 0;
+}
+void CoherentXBar::claimDeferredReceiver(const RequestPtr&r,uint64_t token,unsigned port)
+{ progressCheck(progressState->receiverOwns(r,token,port)); }
+void CoherentXBar::beginResponseHandoff(const RequestPtr&r,uint64_t token,unsigned port)
+{ progressCheck(progressState->beginResponse(r,token,port)); }
+void CoherentXBar::endResponseHandoff(const RequestPtr&r,uint64_t token,unsigned port,bool accepted)
+{ progressCheck(progressState->endResponse(r,token,port,accepted));armProgressWake(); }
+void CoherentXBar::progressResponseAccepted(const RequestPtr&r,uint64_t token)
+{ progressCheck(progressState->responseAccepted(r,token));armProgressWake(); }
+void CoherentXBar::armProgressWake()
+{
+    if (!progressState || !progressState->wakeNeeded()) return;
+    if (!progressState->hasWaiters()) { progressState->consumeWake(); return; }
+    if (!progressWakeEvent.scheduled()) schedule(progressWakeEvent,clockEdge(Cycles(1)));
+}
+void CoherentXBar::wakeProgress()
+{
+    panic_if(!progressState->consumeWake(),"Progress wake inside synchronous handoff");
+    ++progressWakeups;
+    // State changes are complete; callbacks occur on a later clock edge only.
+    for(unsigned n=0;n<cpuSidePorts.size();++n) {
+        unsigned i=(n+progressNextPort)%cpuSidePorts.size();
+        if(progressState->takeWaiter(i)) cpuSidePorts[i]->sendRetryReq();
+    }
+    progressNextPort=(progressNextPort+1)%cpuSidePorts.size();
+    for(unsigned bank=0;bank<4;++bank)
+        if(progressState->takeWaiter(12+bank))progressCacheWake(bank);
+    armProgressWake();
+}
+uint64_t CoherentXBar::reserveProgress(PacketPtr packet,unsigned port)
+{
+    panic_if(!progressSpdRegistered || !progressCachePlan || port>=12,
+             "Incomplete progress registration");
+    const auto bank=findPort(packet);const Addr line=packet->getBlockAddr(64);
+    panic_if(bank<0 || bank>=4 || !packet->req,"Unqualified progress bank/request");
+    const bool producer=progressProducerPorts[port] &&
+        packet->req->requestorId()==progressProducerIDs[port];
+    const auto plan=progressCachePlan(packet);++progressLookups;
+    if(isSpdLine(line)&&plan.targetBlocked) {
+        panic_if(!progressState->setWaiter(port),"Progress waiter bound");
+        ++progressDenied;return 0;
+    }
+    uint64_t token=0;
+    const auto result=progressState->reserve(packet->req,bank,line,producer,
+        isSpdLine(line),bank,plan.parent,plan.continuation,false,token,packet->isSecure());
+    if(result==ProgressResult::Pressure||result==ProgressResult::HandoffBusy) {
+        panic_if(!progressState->setWaiter(port),"Progress waiter bound");
+        ++progressDenied;return 0;
+    }
+    progressCheck(result);progressCheck(progressState->beginSend(token));return token;
+}
+uint64_t CoherentXBar::reserveInternalPrefetch(PacketPtr packet,unsigned bank)
+{
+    panic_if(!progressState || bank>=4 || !progressCachePlan,"Unregistered internal PF owner");
+    const auto plan=progressCachePlan(packet);const Addr line=packet->getBlockAddr(64);
+    ++progressLookups;uint64_t token=0;
+    auto result=ProgressResult::Pressure;
+    if(!plan.targetBlocked)
+        result=progressState->reserve(packet->req,bank,line,false,isSpdLine(line),
+            bank,plan.parent,false,true,token,packet->isSecure());
+    if(result==ProgressResult::Pressure||result==ProgressResult::HandoffBusy){
+        panic_if(!progressState->setWaiter(12+bank),"Internal PF waiter bound");
+        ++progressDenied;return 0;
+    }
+    progressCheck(result);progressCheck(progressState->beginSend(token));
+    ++progressAdmissionCycles;return token;
+}
+void CoherentXBar::finishInternalAdmission(uint64_t token,bool accepted)
+{ progressCheck(progressState->finishSend(token,accepted));armProgressWake(); }
+void CoherentXBar::completeInternalPrefetch(const RequestPtr&r)
+{ progressCheck(progressState->internalComplete(r));armProgressWake(); }
+void CoherentXBar::bindCacheClone(const RequestPtr&a,const RequestPtr&b)
+{
+    panic_if(!a||!b||a.get()==b.get()||!a->hasPaddr()||!b->hasPaddr()||
+        !a->hasSize()||!b->hasSize()||a->getPaddr()!=b->getPaddr()||
+        a->getSize()!=b->getSize()||a->getFlags()!=b->getFlags()||
+        a->requestorId()!=b->requestorId(),"Unqualified cache Request clone");
+    progressCheck(progressState->attachClone(a,b));
+}
+void CoherentXBar::bindMshr(const RequestPtr&r,uintptr_t mshr)
+{ progressCheck(progressState->bindMshr(r,mshr)); }
+uint64_t CoherentXBar::mshrOwner(uintptr_t mshr)const
+{ return progressState?progressState->mshrOwner(mshr):0; }
+void CoherentXBar::releaseMshr(uintptr_t mshr)
+{ progressCheck(progressState->releaseMshr(mshr));armProgressWake(); }
+void CoherentXBar::cacheResourcesChanged()
+{ if(progressState){progressState->changed();armProgressWake();} }
+void CoherentXBar::chargeDeferredService() { ++progressDeferredCycles; }
+bool CoherentXBar::quiescent()const
+{ return !progressState || (progressState->quiescent()&&!progressWakeEvent.scheduled()); }
+DrainState CoherentXBar::drain()
+{
+    panic_if(!quiescent(),"Progress broker cannot checkpoint live credits/owners/waiters/events");
+    return DrainState::Drained; // Original port/layer Drainables retain their own drain checks.
+}

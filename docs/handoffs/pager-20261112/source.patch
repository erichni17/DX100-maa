+Addr MAA::devicePageBacking() const {
+    panic_if(addrRegions[31].first == 0 ||
+                 (addrRegions[31].first & 63) != 0 ||
+                 addrRegions[31].second - addrRegions[31].first <
+                     static_cast<Addr>(num_tiles) * num_tile_elements * 4,
+             "Device SPD needs dedicated aligned backing in init region31");
+    return addrRegions[31].first;
+}
+std::array<int, 4>
+MAA::deviceOperands(const Instruction *instruction) const {
+    using O = Instruction::OpcodeType;
+    panic_if(instruction->condSpdID != -1 &&
+                 instruction->opcode != O::STREAM_LD &&
+                 instruction->opcode != O::INDIR_LD &&
+                 instruction->opcode != O::INDIR_RMW_VECTOR &&
+                 instruction->opcode != O::ALU_VECTOR &&
+                 instruction->opcode != O::ALU_SCALAR,
+             "Device SPD masks support native Stream/gather/vector RMW only");
+    std::array<int, 4> tiles{{-1, -1, -1, -1}};
+    unsigned count = 0;
+    // Lease the predicate alongside the data, including its generation.
+    // Original native engines retain all readiness tests and mask decisions.
+    for (int tile : {instruction->condSpdID, instruction->src1SpdID,
+                     instruction->src2SpdID, instruction->dst1SpdID,
+                     instruction->dst2SpdID}) {
+        if (tile == -1) continue;
+        // Original OpenMP allocation assigns IDs in allocation order, not
+        // core_id order. Dynamic paging shares the existing 32-ID namespace;
+        // the single admitted command owns its complete generation lease.
+        panic_if(tile < 0 || tile >= static_cast<int>(num_tiles) ||
+                     (deviceFixedMap() && tile >= 8),
+                 "Device SPD operand leaves supported logical namespace");
+        if (std::find(tiles.begin(), tiles.end(), tile) != tiles.end())
+            continue;
+        panic_if(count == tiles.size(),
+                 "Device SPD command exceeds four page leases");
+        tiles[count++] = tile;
+    }
+    return tiles;
+}
+bool MAA::admitDeviceInstruction(Instruction *instruction) {
+    if (!devicePaging()) return true;
+    if (!deviceOverlap() && deviceInstruction) return false;
+    devicePageBacking();
+    panic_if(instruction->core_id < 0 ||
+                 instruction->core_id >= static_cast<int>(num_cores) ||
+                 instruction->maa_id != 0 ||
+                 (deviceFixedMap() && instruction->core_id != 0) ||
+                 instruction->hasLogicalOperands() ||
+                 instruction->controllerManaged ||
+                 instruction->WordSize() != 4,
+             "Device SPD requires original 32-bit native commands on MAA0; "
+             "fixed mapping supports worker0 only");
+    using O = Instruction::OpcodeType;
+    panic_if(instruction->opcode != O::RANGE_LOOP &&
+                 instruction->opcode != O::STREAM_LD &&
+                 instruction->opcode != O::INDIR_LD &&
+                 instruction->opcode != O::ALU_VECTOR &&
+                 instruction->opcode != O::ALU_SCALAR &&
+                 instruction->opcode != O::INDIR_RMW_VECTOR,
+             "Unsupported native opcode in device SPD mode");
+    const auto tiles = deviceOperands(instruction);
+    // Reuse one existing lease record for serialized mode. This adds mask
+    // generation checks without a new payload bank or a fourth operand slot.
+    auto &lease = deviceEngineLeases[
+        deviceOverlap() ? deviceOwnerIndex(instruction) : 0];
+    if (lease.instruction) return false;
+    lease.instruction = instruction;
+    lease.tiles = tiles;
+    for (unsigned i = 0; i < lease.tiles.size(); ++i)
+        if (lease.tiles[i] != -1)
+            lease.generations[i] = spd->tileGeneration(lease.tiles[i]);
+    if (deviceOverlap()) {
+        unsigned active = 0;
+        for (const auto &owner : deviceEngineLeases) active += owner.instruction != nullptr;
+        devicePeakActive = std::max(devicePeakActive, active);
+    } else {
+        deviceInstruction = instruction;
+        deviceEpoch = -1;
+    }
+    return true;
+}
+void MAA::releaseDevicePages(bool final) {
+    panic_if(deviceOverlap() && hasDeviceCommands(),
+             "Global SPD unpin attempted with live engine owners");
+    // Fit32 can retain all pages of every supported command. Stock RT refill
+    // may still own offsets after a response epoch, so keep pins until final
+    // instruction retirement rather than inferring lifetime from responses.
+    if (deviceFit32() && !final) return;
+    spd->releasePages(); deviceEpoch = -1;
+    for (auto *port : cpuSidePorts) port->retryTileRequest();
+}
+bool MAA::ensureDevicePages(Instruction *instruction, int ordinal) {
+    if (!devicePaging()) return true;
+    if (deviceOverlap()) {
+        const unsigned owner = deviceOwnerIndex(instruction);
+        auto &lease = deviceEngineLeases[owner];
+        panic_if(lease.instruction != instruction || ordinal < 0 || ordinal > 16384,
+                 "Invalid engine-owned SPD lease");
+        // Native units use one-past-the-tile to await producer Finished.
+        // There is no page to map for that readiness-only sentinel.
+        if (ordinal == 16384) { lease.epoch = 4; return true; }
+        lease.epoch = ordinal / 4096;
+        for (unsigned i = 0; i < lease.tiles.size(); ++i) {
+            if (lease.tiles[i] == -1) continue;
+            panic_if(spd->tileGeneration(lease.tiles[i]) != lease.generations[i],
+                     "SPD generation changed under an active reader/producer");
+            if (!spd->leasePage(lease.tiles[i], ordinal, true, 1U << owner)) {
+                lease.epoch |= DeviceMappingWait;
+                return false;
+            }
+        }
+        return true;
+    }
+    panic_if(deviceInstruction != instruction || ordinal < 0 || ordinal > 16384,
+             "Device SPD page lease has invalid instruction/ordinal");
+    if (ordinal == 16384) return true;
+    const int epoch = ordinal / 4096;
+    panic_if(!deviceFit32() && deviceEpoch != -1 && deviceEpoch != epoch,
+             "Device SPD advanced without draining its previous page lease");
+    deviceEpoch = epoch;
+    const auto &lease = deviceEngineLeases[0];
+    panic_if(lease.instruction != instruction,
+             "Device SPD serial lease owner mismatch");
+    for (unsigned i = 0; i < lease.tiles.size(); ++i) {
+        const int tile = lease.tiles[i];
+        if (tile == -1) continue;
+        panic_if(spd->tileGeneration(tile) != lease.generations[i],
+                 "Device SPD mask/data generation changed "
+                 "under serial command");
+        if (!spd->ensurePage(tile, ordinal)) return false;
+    }
+    return true;
+}
+void MAA::wakeDevicePager() {
+    if (deviceOverlap()) {
+        for (auto &lease : deviceEngineLeases) {
+            Instruction *instruction = lease.instruction;
+            if (!instruction || lease.epoch < 0 ||
+                !(lease.epoch & DeviceMappingWait)) continue;
+            // Consume one coalesced mapping notification. An existing native
+            // event already promises a retry; later page completions must not
+            // mistake an extent/element wait for another mapping wait.
+            lease.epoch &= ~DeviceMappingWait;
+            const int unit = instruction->func_unit_id;
+            switch (instruction->funcUniType) {
+              case FuncUnitType::STREAM:
+                streamAccessUnits[unit].wakeDevicePage(); break;
+              case FuncUnitType::INDIRECT:
+                if (indirectAccessUnits[unit].getState() == IndirectAccessUnit::Status::Fill ||
+                    indirectAccessUnits[unit].getState() == IndirectAccessUnit::Status::Request)
+                    indirectAccessUnits[unit].scheduleNextExecution(true);
+                break;
+              case FuncUnitType::ALU:
+                aluUnits[unit].wakeDevicePage(); break;
+              case FuncUnitType::RANGE:
+                rangeUnits[unit].scheduleNextExecution(true); break;
+              default: panic("Unsupported overlapping SPD wakeup");
+            }
+        }
+    }
+    if (deviceInstruction) {
+        const int unit = deviceInstruction->func_unit_id;
+        switch (deviceInstruction->funcUniType) {
+          case FuncUnitType::STREAM:
+            streamAccessUnits[unit].scheduleExecuteInstructionEvent(1); break;
+          case FuncUnitType::INDIRECT:
+            indirectAccessUnits[unit].scheduleExecuteInstructionEvent(1); break;
+          case FuncUnitType::ALU:
+            aluUnits[unit].scheduleExecuteInstructionEvent(1); break;
+          case FuncUnitType::RANGE:
+            rangeUnits[unit].scheduleNextExecution(true); break;
+          default: panic("Unsupported device SPD wakeup");
+        }
+    }
+    if (!hasDeviceCommands() && !invalidatorIdle)
+        invalidator->wakeDevicePage();
+    // Serialized admission also waits on CPU-originated destination transfers.
+    // Completion releases that wait even when no engine is currently active.
+    DPRINTF(MAAOperationSummary, "pager_admission_completion_wake serial=%d\n",
+            !deviceOverlap());
+    scheduleDispatchInstructionEvent();
+    for (auto *port : cpuSidePorts) port->retryTileRequest();
+}
+unsigned MAA::deviceOwnerIndex(const Instruction *instruction) const {
+    panic_if(instruction->core_id != 0 || instruction->maa_id != 0,
+             "Engine leases initially support worker0/MAA0 only");
+    switch (instruction->funcUniType) {
+      case FuncUnitType::STREAM: return 0;
+      case FuncUnitType::INDIRECT: return 1;
+      case FuncUnitType::ALU: return 2;
+      case FuncUnitType::RANGE: return 3;
+      default: panic("Unsupported SPD engine owner");
+    }
+}
+bool MAA::hasDeviceCommands() const {
+    if (deviceInstruction) return true;
+    for (const auto &lease : deviceEngineLeases)
+        if (lease.instruction) return true;
+    return false;
+}
+bool MAA::deviceDispatchBlocked(FuncUnitType type) const {
+    if (!deviceOverlap())
+        return deviceInstruction || (type != FuncUnitType::INVALIDATOR && !invalidatorIdle);
+    // Invalidation has its own global owner, never sharing a release with
+    // native engine leases. Original IF operand/producer hazards stay active.
+    return type == FuncUnitType::INVALIDATOR ? hasDeviceCommands() : !invalidatorIdle;
+}
+void MAA::releaseDevicePages(Instruction *instruction, bool final) {
+    if (!final) {
+        if (!deviceOverlap()) releaseDevicePages(false);
+        return; // Offsets/responses may still reference earlier pages.
+    }
+    const unsigned owner = deviceOverlap() ? deviceOwnerIndex(instruction) : 0;
+    auto &lease = deviceEngineLeases[owner];
+    panic_if(lease.instruction != instruction, "SPD engine retirement owner mismatch");
+    for (unsigned i = 0; i < lease.tiles.size(); ++i)
+        panic_if(lease.tiles[i] != -1 &&
+                 spd->tileGeneration(lease.tiles[i]) != lease.generations[i],
+                 "SPD generation changed before engine retirement");
+    if (deviceOverlap()) spd->releaseOwnerPages(1U << owner);
+    else releaseDevicePages(true);
+    lease = DeviceEngineLease{};
+    for (auto *port : cpuSidePorts) port->retryTileRequest();
+}
+
+}
+
+namespace gem5 {
+bool MAA::ensureDeviceRangePages(Instruction *instruction, int row, int edge) {
+    if (!devicePaging()) return true;
+    const unsigned owner = deviceOverlap() ? deviceOwnerIndex(instruction) : 0;
+    auto &lease = deviceEngineLeases[owner];
+    panic_if(lease.instruction != instruction || row < 0 || row >= 16384 ||
+             edge < 0 || edge >= 16384, "Invalid Range page cursor");
+    const int epoch = (row / 4096) * 4 + edge / 4096;
+    if ((lease.epoch & ~DeviceMappingWait) != epoch) {
+        spd->releaseOwnerPages(1U << owner);
+        lease.epoch = epoch;
+    }
+    for (unsigned i = 0; i < lease.tiles.size(); ++i) {
+        const int tile = lease.tiles[i];
+        if (tile == -1) continue;
+        panic_if(spd->tileGeneration(tile) != lease.generations[i],
+                 "Range generation changed under lease");
+        const bool output = tile == instruction->dst1SpdID ||
+                            tile == instruction->dst2SpdID;
+        if (!spd->leasePage(tile, output ? edge : row, true, 1U << owner)) {
+            lease.epoch = epoch | DeviceMappingWait;
+            return false;
+        }
+    }
+    lease.epoch = epoch;
+    return true;
+}
+}

+ }
+ Token mshrOwner(std::uintptr_t mshr)const{for(const auto&c:cells)if(c.mshr==mshr&&mshr)return c.token;return 0;}
+ Result releaseMshr(std::uintptr_t mshr){auto*c=find(mshrOwner(mshr));if(!c)return Result::Invalid;c->mshr=0;releasePhysical(*c);settle();return Result::Granted;}

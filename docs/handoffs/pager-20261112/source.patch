+  if(!handoffs&&!deliveries&&hasWaiters())wake=true;
+  return Result::Granted;
+ }
+ Result responseAccepted(const Ref&r,Token t){auto*c=find(t);if(!c||!bound(*c,r)||c->response||c->delivering||(c->phase!=Phase::Sending&&c->phase!=Phase::Accepted))return Result::Invalid;c->response=true;settle();return Result::Granted;}
+ Result internalComplete(const Ref&r){auto*c=find(active(r));if(!c||!c->internal)return Result::Invalid;return responseAccepted(r,c->token);}
+ bool isInternal(const Ref&r)const{const auto*c=find(active(r));return c&&c->internal;}
+ bool setWaiter(unsigned i){if(i>=waiters.size())return false;waiters[i]=true;return true;}
+ bool waiting(unsigned i)const{return i<waiters.size()&&waiters[i];}
+ bool takeWaiter(unsigned i){if(!waiting(i))return false;waiters[i]=false;return true;}
+ bool hasWaiters()const{for(bool w:waiters)if(w)return true;return false;}
+ void changed(){if(hasWaiters())wake=true;}
+ bool wakeNeeded()const{return wake&&!handoffs&&!deliveries;}
+ bool consumeWake(){if(handoffs||deliveries)return false;wake=false;return true;}
+ bool quiescent()const{return !used&&!handoffs&&!deliveries&&!wake&&!hasWaiters();}
+ unsigned bankUsed(unsigned i)const{return physical.at(i);}
+ unsigned deferredUsed()const{return deferred;}
+ unsigned transactionCount()const{return used;}
+};
+}

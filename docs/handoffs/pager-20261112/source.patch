+#ifndef UME_SHARED_PROGRESS_STATE_HH
+#define UME_SHARED_PROGRESS_STATE_HH
+#include <array>
+#include <cstdint>
+#include <limits>
+namespace gem5::maa {
+// Fixed transaction storage; existing physical cache capacity remains 4x64.
+// MSHR ownership survives early responses, clones and deferred/locked targets.
+template<class Ref> class SharedProgressState {
+ public:
+ using Token=std::uint64_t;
+ enum class Phase { Empty, Reserved, Sending, Accepted };
+ enum class Result { Granted, Pressure, Invalid, HandoffBusy };
+ static constexpr unsigned Banks=4, Entries=2048, Deferred=64, Targets=7;
+ struct Cell {
+  Ref request{},clone{};Token token=0,parent=0;std::uint64_t line=0;
+  std::uintptr_t mshr=0;unsigned bank=0,port=0;
+  Phase phase=Phase::Empty;
+  bool secure=false,producer=false,spd=false,physical=false,receiver=false,handoff=false;
+  bool response=false,responseBeforeHandoff=false,clonePending=false,internal=false,delivering=false;
+ };
+ private:
+ std::array<Cell,Entries> cells{};
+ std::array<unsigned,Banks> physical{},ordinary{};
+ std::array<bool,16> waiters{};
+ unsigned deferred=0,used=0,ordinaryTransactions=0,handoffs=0,deliveries=0;
+ Token next=1;bool wake=false;
+ static bool same(const Ref&a,const Ref&b){return a&&b&&a.get()==b.get()&&!a.owner_before(b)&&!b.owner_before(a);}
+ bool bound(const Cell&c,const Ref&r)const{return same(c.request,r)||same(c.clone,r);}
+ Cell*find(Token t){for(auto&c:cells)if(t&&c.token==t)return &c;return nullptr;}
+ const Cell*find(Token t)const{for(const auto&c:cells)if(t&&c.token==t)return &c;return nullptr;}
+ void releasePhysical(Cell&c){if(c.physical){--physical[c.bank];if(!c.producer)--ordinary[c.bank];c.physical=false;wake=true;}}
+ void erase(Cell&c){releasePhysical(c);if(c.spd)--deferred;if(!c.producer)--ordinaryTransactions;--used;c={};wake=true;}
+ void settle(){if(handoffs||deliveries)return;for(auto&c:cells)if(c.phase==Phase::Accepted&&c.response&&!c.receiver&&!c.handoff&&!c.mshr&&!c.clonePending)erase(c);}
+ public:
+ Result reserve(const Ref&r,unsigned bank,std::uint64_t line,bool producer,bool spd,unsigned port,Token parent,bool continuation,bool internal,Token&out,bool secure=false){
+  out=0;if(!r||bank>=Banks||port>=Banks||line%64||(producer&&spd))return Result::Invalid;
+  if(handoffs||deliveries)return Result::HandoffBusy;
+  const Cell*pc=parent?find(parent):nullptr;
+  if(parent&&(!pc||!pc->mshr||pc->bank!=bank||pc->line!=line||pc->secure!=secure))return Result::Invalid;
+  // A locked write releases its existing target; it is not another deferred read.
+  if(continuation){if(!pc)return Result::Invalid;if(!pc->response)return Result::Pressure;spd=false;}
+  for(const auto&c:cells)if(c.phase!=Phase::Empty&&bound(c,r)){
+   if(!(continuation&&parent==c.token&&c.response&&c.mshr))return Result::Invalid;
+  }
+  if(used==Entries||(!producer&&!continuation&&ordinaryTransactions>=Entries-4))return Result::Pressure;
+  if(!parent&&(physical[bank]>=64||(!producer&&ordinary[bank]>=63)))return Result::Pressure;

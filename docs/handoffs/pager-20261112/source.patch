+ Result beginResponse(const Ref&r,Token t,unsigned port){auto*c=find(t);if(!c||!bound(*c,r)||c->port!=port||!c->receiver||c->handoff)return Result::Invalid;c->handoff=true;c->responseBeforeHandoff=c->response;++handoffs;return Result::Granted;}
+ Result endResponse(const Ref&r,Token t,unsigned port,bool accepted){auto*c=find(t);if(!c||!bound(*c,r)||c->port!=port||!c->handoff||!handoffs||(!accepted&&c->response&&!c->responseBeforeHandoff))return Result::Invalid;
+  if(accepted)c->receiver=false;
+  c->handoff=false;--handoffs;settle();
+  if(!handoffs&&!deliveries)for(bool w:waiters)if(w){wake=true;break;}
+  return Result::Granted;
+ }
+ // General response delivery may reenter admission before the peer returns.
+ // Retain the original Request and token until success/refusal is known. Neither
+ // local receiver capacity nor shared credits may retire during either barrier.
+ Result beginDelivery(const Ref&r,Token t){auto*c=find(t);
+  if(!c||!bound(*c,r)||c->response||c->delivering||(c->phase!=Phase::Sending&&c->phase!=Phase::Accepted))return Result::Invalid;
+  c->delivering=true;++deliveries;return Result::Granted;
+ }
+ Result finishDelivery(const Ref&r,Token t,bool accepted){auto*c=find(t);
+  if(!c||!bound(*c,r)||!c->delivering||!deliveries||c->response)return Result::Invalid;
+  if(accepted)c->response=true;
+  c->delivering=false;--deliveries;settle();

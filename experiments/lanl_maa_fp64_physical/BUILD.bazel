load("//:openroad.bzl", "orfs_flow")
load(":portfolio_power.bzl", "portfolio_power_data")

HARDFLOAT_SOURCES = [
    "//lanl_fp64/hardfloat:HardFloat_primitives.v",
    "//lanl_fp64/hardfloat:HardFloat_rawFN.v",
    "//lanl_fp64/hardfloat:HardFloat_specialize.v",
    "//lanl_fp64/hardfloat:addRecFN.v",
    "//lanl_fp64/hardfloat:divSqrtRecFN_small.v",
    "//lanl_fp64/hardfloat:fNToRecFN.v",
    "//lanl_fp64/hardfloat:isSigNaNRecFN.v",
    "//lanl_fp64/hardfloat:mulAddRecFN.v",
    "//lanl_fp64/hardfloat:mulRecFN.v",
    "//lanl_fp64/hardfloat:recFNToFN.v",
]

COMMON_ARGUMENTS = {
    "CORE_UTILIZATION": "40",
    "GPL_ROUTABILITY_DRIVEN": "1",
    "GPL_TIMING_DRIVEN": "1",
    "NUM_CORES": "4",
    "PLACE_DENSITY": "0.60",
    "REMOVE_ABC_BUFFERS": "0",
    "SKIP_CTS_REPAIR_TIMING": "0",
    "SKIP_INCREMENTAL_REPAIR": "0",
    "SKIP_REPORT_METRICS": "0",
    "VERILOG_INCLUDE_DIRS": "lanl_fp64/hardfloat",
}

TOPS = {
    "fp64_add": "LanlFp64Add",
    "fp64_div1": "LanlFp64Div1",
    "fp64_div4": "LanlFp64Div4",
    "fp64_div8": "LanlFp64Div8",
    "fp64_fma": "LanlFp64Fma",
    "fp64_mul": "LanlFp64Mul",
    "fp64_portfolio_1a1m8d": "LanlFp64Portfolio1A1M8D",
    "fp64_portfolio_2s1a1m8d": "LanlFp64Portfolio2S1A1M8D",
}

[orfs_flow(
    name = name,
    arguments = COMMON_ARGUMENTS,
    last_stage = "final",
    pdk = "@orfs//flow:nangate45",
    sources = {
        "SDC_FILE": [":constraints.sdc"],
    },
    stage_data = {
        "synth": ["//lanl_fp64/hardfloat:include"],
    },
    tags = ["manual"],
    top = top,
    verilog_files = HARDFLOAT_SOURCES + ["rtl/LanlFp64HardFloat.v"],
) for name, top in TOPS.items()]

orfs_flow(
    name = "fp64_portfolio_2s_shared_recode_1a1m8d",
    arguments = COMMON_ARGUMENTS,
    last_stage = "final",
    pdk = "@orfs//flow:nangate45",
    sources = {
        "SDC_FILE": [":constraints.sdc"],
    },
    stage_data = {
        "synth": ["//lanl_fp64/hardfloat:include"],
    },
    tags = ["manual"],
    top = "LanlFp64Portfolio2SSharedRecode1A1M8D",
    verilog_files = HARDFLOAT_SOURCES + [
        "rtl/LanlFp64HardFloat.v",
        "rtl/LanlFp64DualSharedRecode.v",
    ],
)

filegroup(
    name = "fp64_portfolio_final_verilog",
    srcs = [":fp64_portfolio_1a1m8d_final"],
    output_group = "6_final.v",
)

filegroup(
    name = "fp64_dual_portfolio_final_verilog",
    srcs = [":fp64_portfolio_2s1a1m8d_final"],
    output_group = "6_final.v",
)

filegroup(
    name = "fp64_dual_portfolio_final_spef",
    srcs = [":fp64_portfolio_2s1a1m8d_final"],
    output_group = "6_final.spef",
)

filegroup(
    name = "fp64_shared_recode_portfolio_final_verilog",
    srcs = [":fp64_portfolio_2s_shared_recode_1a1m8d_final"],
    output_group = "6_final.v",
)

filegroup(
    name = "fp64_shared_recode_portfolio_final_spef",
    srcs = [":fp64_portfolio_2s_shared_recode_1a1m8d_final"],
    output_group = "6_final.spef",
)

filegroup(
    name = "fp64_portfolio_final_spef",
    srcs = [":fp64_portfolio_1a1m8d_final"],
    output_group = "6_final.spef",
)

[
    genrule(
        name = "fp64_portfolio_{}_saif".format(profile),
        srcs = [
            "activity/portfolio_activity_contract.json",
            "scripts/generate_portfolio_saif.py",
        ],
        outs = ["fp64_portfolio_{}.saif".format(profile)],
        cmd = "python3 $(location scripts/generate_portfolio_saif.py) " +
              "--contract $(location activity/portfolio_activity_contract.json) " +
              "--profile {} --output $@".format(profile),
        tags = ["manual"],
    )
    for profile in [
        "umt_32_context",
        "sparta_64_particle",
        "amg_sparse_normalized",
    ]
]

[
    genrule(
        name = "fp64_dual_portfolio_{}_saif".format(profile),
        srcs = [
            "activity/portfolio_activity_contract.json",
            "scripts/generate_dual_portfolio_saif.py",
            "scripts/generate_portfolio_saif.py",
        ],
        outs = ["fp64_dual_portfolio_{}.saif".format(profile)],
        cmd = "python3 $(location scripts/generate_dual_portfolio_saif.py) " +
              "--contract $(location activity/portfolio_activity_contract.json) " +
              "--profile {} --output $@".format(profile),
        tags = ["manual"],
    )
    for profile in [
        "umt_32_context",
        "sparta_64_particle",
        "amg_sparse_normalized",
    ]
]

[
    genrule(
        name = "fp64_shared_recode_portfolio_{}_saif".format(profile),
        srcs = [
            "activity/portfolio_activity_contract.json",
            "scripts/generate_dual_portfolio_saif.py",
            "scripts/generate_portfolio_saif.py",
        ],
        outs = ["fp64_shared_recode_portfolio_{}.saif".format(profile)],
        cmd = "python3 $(location scripts/generate_dual_portfolio_saif.py) " +
              "--contract $(location activity/portfolio_activity_contract.json) " +
              "--top LanlFp64Portfolio2SSharedRecode1A1M8D " +
              "--profile {} --output $@".format(profile),
        tags = ["manual"],
    )
    for profile in [
        "umt_32_context",
        "sparta_64_particle",
        "amg_sparse_normalized",
    ]
]

[
    portfolio_power_data(
        name = "fp64_portfolio_{}_power".format(profile),
        flow_target = ":fp64_portfolio_1a1m8d_final",
        out_template = "fp64_portfolio_{}_{{power}}_power.json".format(profile),
        saif = ":fp64_portfolio_{}_saif".format(profile),
        saif_scope = "TOP/LanlFp64Portfolio1A1M8D",
        spef = ":fp64_portfolio_final_spef",
        stage = "final",
        verilog = ":fp64_portfolio_final_verilog",
    )
    for profile in [
        "umt_32_context",
        "sparta_64_particle",
        "amg_sparse_normalized",
    ]
]

[
    portfolio_power_data(
        name = "fp64_dual_portfolio_{}_power".format(profile),
        flow_target = ":fp64_portfolio_2s1a1m8d_final",
        out_template = "fp64_dual_portfolio_{}_{{power}}_power.json".format(profile),
        saif = ":fp64_dual_portfolio_{}_saif".format(profile),
        saif_scope = "TOP/LanlFp64Portfolio2S1A1M8D",
        spef = ":fp64_dual_portfolio_final_spef",
        stage = "final",
        verilog = ":fp64_dual_portfolio_final_verilog",
    )
    for profile in [
        "umt_32_context",
        "sparta_64_particle",
        "amg_sparse_normalized",
    ]
]

[
    portfolio_power_data(
        name = "fp64_shared_recode_portfolio_{}_power".format(profile),
        flow_target = ":fp64_portfolio_2s_shared_recode_1a1m8d_final",
        out_template = "fp64_shared_recode_portfolio_{}_{{power}}_power.json".format(profile),
        saif = ":fp64_shared_recode_portfolio_{}_saif".format(profile),
        saif_scope = "TOP/LanlFp64Portfolio2SSharedRecode1A1M8D",
        spef = ":fp64_shared_recode_portfolio_final_spef",
        stage = "final",
        verilog = ":fp64_shared_recode_portfolio_final_verilog",
    )
    for profile in [
        "umt_32_context",
        "sparta_64_particle",
        "amg_sparse_normalized",
    ]
]
